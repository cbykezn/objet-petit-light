---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---
<BaseLayout title="聯絡 — Objet Petit L" description={`聯絡小幻光設計所：${site.email}`} canonicalPath="/contact"><section class="contact-intro section"><p class="eyebrow">Contact</p><h1>說說你的計畫。</h1><p>劇場、舞蹈、空間、展覽與活動燈光設計合作，請使用下方表單或直接寄信。</p></section></BaseLayout>
<style>.contact-intro{padding-bottom:clamp(2rem,5vw,4rem)}.contact-intro h1{font-size:clamp(3rem,8vw,8rem);font-weight:500;line-height:1.05}.contact-intro p:last-child{max-width:34rem;font-size:1.1rem}</style>
