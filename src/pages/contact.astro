---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="聯絡 — Objet Petit L"><section class="contact section"><p class="eyebrow">Contact</p><h1>說說你的計畫。</h1><form id="contact-form"><label>姓名<input required name="name" autocomplete="name" /></label><label>電子郵件<input required name="email" type="email" autocomplete="email" /></label><label>訊息<textarea required name="message" rows="5"></textarea></label><button type="submit">SEND MESSAGE →</button></form><p class="fallback">或直接寄信：<a href="mailto:hello@objetpetitlight.com">hello@objetpetitlight.com</a></p></section></BaseLayout>
<script>document.querySelector<HTMLFormElement>('#contact-form')?.addEventListener('submit',(event)=>{event.preventDefault();const data=new FormData(event.currentTarget);const subject=encodeURIComponent(`網站聯絡：${data.get('name')}`);const body=encodeURIComponent(`姓名：${data.get('name')}\nEmail：${data.get('email')}\n\n${data.get('message')}`);location.href=`mailto:hello@objetpetitlight.com?subject=${subject}&body=${body}`});</script>
<style>.contact{max-width:900px}.contact h1{font-size:clamp(3rem,8vw,8rem);font-weight:500;line-height:1.05}form{display:grid;gap:1rem;margin-top:3rem}label{display:grid;gap:.4rem;font-family:'IBM Plex Mono',monospace;font-size:11px}input,textarea{width:100%;padding:.7rem 0;border:0;border-bottom:1px solid var(--ink);border-radius:0;background:transparent;font:16px 'Noto Sans TC',sans-serif}button{justify-self:start;margin-top:1rem;padding:0;border:0;background:none;cursor:pointer;font-family:'IBM Plex Mono',monospace;font-size:12px;text-decoration:underline;text-underline-offset:.4rem}.fallback{margin-top:3rem}.fallback a{text-decoration:underline}</style>
