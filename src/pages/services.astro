---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../lib/paths';
const items=[['劇場／舞蹈','Theatre / Dance','/services/theater-dance'],['空間燈光','Spatial Lighting','/services/space-lighting'],['展覽','Exhibition','/services/exhibition'],['活動','Events','/services/events']];
---
<BaseLayout title="服務 — Objet Petit L" canonicalPath="/services"><section class="section"><p class="eyebrow">Services</p><h1 class="section-title">服務</h1><div class="list">{items.map(([name,en,href])=><a href={sitePath(href)}><span>{name}</span><small>{en}</small><b>→</b></a>)}</div></section></BaseLayout><style>.list{border-top:1px solid var(--line)}.list a{display:grid;grid-template-columns:1fr 1fr auto;align-items:center;padding:1rem 0;border-bottom:1px solid var(--line);font-size:clamp(1.5rem,4vw,4rem)}small{font-family:'IBM Plex Mono',monospace;font-size:11px}b{font-weight:400}@media(max-width:600px){.list a{grid-template-columns:1fr auto}.list small{display:none}}</style>
