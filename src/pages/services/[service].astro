---
import snapshots from '../../data/framer-services.json';
import theaterCss from '../../styles/services/theater-dance.css?url';
import spaceCss from '../../styles/services/space-lighting.css?url';
import exhibitionCss from '../../styles/services/exhibition.css?url';
import eventsCss from '../../styles/services/events.css?url';
import '../../styles/home-interactions.css';
import { sitePath } from '../../lib/paths';
import { site } from '../../config/site';
export function getStaticPaths() {
  return snapshots.map(content => ({ params: { service: content.slug }, props: { content } }));
}
const { content } = Astro.props;
const css = { 'theater-dance': theaterCss, 'space-lighting': spaceCss, exhibition: exhibitionCss, events: eventsCss };
const markup = content.body.replace(/href="(?:\.\.\/|https:\/\/objetpetitlight\.framer\.website\/)([^"]*)"/g, (_, path) => `href="${sitePath('/' + path)}"`);
const canonical = new URL(sitePath('/services/' + content.slug), Astro.site);
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || 'JME5hkEBdaK-VIW6btaBN-jSAy5lRyrK6TeR1f9HAuc';
---
<!doctype html>
<html lang="zh-Hant-TW" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{content.title}</title>
    <meta name="description" content={content.description || site.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={content.title} />
    <meta property="og:description" content={content.description || site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://framerusercontent.com/images/raWnl31aY07k9ncDMvgqXYD864.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    {verification && <meta name="google-site-verification" content={verification} />}
    <link rel="icon" href="https://framerusercontent.com/images/Ore2V7jwc6PDMNYdVHoAivitqss.jpg" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chiron+Hei+HK:ital,wght@0,400;0,600&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={css[content.slug as keyof typeof css]} />
  </head>
  <body data-home-base={sitePath('/')}>
    <Fragment set:html={markup} />
    <script src="../../scripts/home-interactions.ts"></script>
  </body>
</html>
