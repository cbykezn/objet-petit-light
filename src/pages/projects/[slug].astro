---
import shell from '../../data/framer-project.html?raw';
import '../../styles/framer-project.css';
import '../../styles/home-interactions.css';
import ProjectGallery from '../../components/ProjectGallery.astro';
import ProjectCredits from '../../components/ProjectCredits.astro';
import { activeProjects } from '../../data/projects';
import { assetPath, sitePath } from '../../lib/paths';
import { site } from '../../config/site';
export function getStaticPaths() { return activeProjects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const gallery = project.gallery.length ? project.gallery : [project.cover];
const escapeHtml = (value: string) => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
const archives = { theater:'/theater', dance:'/dance', architecture:'/architecture-landscape', exhibition:'/exhib.-event', upcoming:'/#selected' };
const replacements: Record<string, string> = {
  __PROJECT_TITLE__: escapeHtml(project.title),
  __COMPANY__: escapeHtml(project.company),
  __VENUE__: project.infoLink ? `<a href="${escapeHtml(project.infoLink)}" target="_blank" rel="noopener noreferrer" style="color:inherit;text-decoration:none" aria-label="活動資訊">${escapeHtml(project.venue)}</a>` : escapeHtml(project.venue),
  __ARCHIVE_HREF__: sitePath(archives[project.category as keyof typeof archives]),
};
const markup = shell.replace(/href="(?:\.\.\/|https:\/\/objetpetitlight\.framer\.website\/)([^"]*)"/g, (_, path) => `href="${sitePath('/' + path)}"`)
  .replace(/__PROJECT_TITLE__|__COMPANY__|__VENUE__|__ARCHIVE_HREF__/g, key => replacements[key]);
const [beforeGallery, rest] = markup.split('__GALLERY_SLOT__');
const [beforeCredits, afterCredits] = rest.split('__CREDITS_SLOT__');
const canonical = new URL(sitePath('/projects/' + project.slug), Astro.site);
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || 'JME5hkEBdaK-VIW6btaBN-jSAy5lRyrK6TeR1f9HAuc';
---
<!doctype html>
<html lang="zh-Hant-TW" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{project.seoTitle || project.title + ' — Objet Petit L'}</title>
    <meta name="description" content={project.seoDescription || site.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={project.seoTitle || project.title} />
    <meta property="og:description" content={project.seoDescription || site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(assetPath(project.cover), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {verification && <meta name="google-site-verification" content={verification} />}
    <link rel="icon" href="https://framerusercontent.com/images/Ore2V7jwc6PDMNYdVHoAivitqss.jpg" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chiron+Hei+HK:ital,wght@0,400;0,600&amp;display=swap" rel="stylesheet" />
  </head>
  <body data-home-base={sitePath('/')}>
    <Fragment set:html={beforeGallery} /><ProjectGallery images={gallery} title={project.title} /><Fragment set:html={beforeCredits} /><ProjectCredits credits={project.credits} /><Fragment set:html={afterCredits} />
    <script src="../../scripts/home-interactions.ts"></script>
  </body>
</html>
