---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkIndex from '../components/WorkIndex.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { activeProjects } from '../data/projects';
import { assetPath, sitePath } from '../lib/paths';
const landing = activeProjects.filter((project) => project.showOnLanding).sort((a,b) => a.landingOrder - b.landingOrder).slice(0, 4);
const selected = activeProjects.filter((project) => project.selectedUpcoming === 'Selected').sort((a,b) => a.homepageOrder - b.homepageOrder);
const upcoming = activeProjects.filter((project) => project.selectedUpcoming === 'Upcoming').sort((a,b) => a.homepageOrder - b.homepageOrder);
---
<BaseLayout>
  <section class="landing" aria-label="Objet Petit L">
    <div class="slides">{landing.map((project, index) => <picture class:list={[{visible:index === 0}]}>
      {project.landingImageMobile && <source media="(max-width:700px)" srcset={assetPath(project.landingImageMobile)} />}
      <img src={assetPath(project.landingImage || project.cover)} alt={`${project.title} 劇照`} style={`--desktop-position:${project.heroDesktopFocusX} ${project.heroDesktopFocusY};--mobile-position:${project.heroMobileFocusX} ${project.heroMobileFocusY}`} />
    </picture>)}</div>
    <div class="landing-copy"><p class="eyebrow">Lighting Design Studio — Taipei</p><h1>Objet<br />Petit L</h1><a href="#works">VIEW WORKS <span>↓</span></a></div>
  </section>
  <section class="manifesto section"><p class="eyebrow">Studio Manifesto</p><h2>以光為語言，為舞台、身體與空間建立感知的節奏。</h2><p>Objet Petit L 是由黃俊諺創立的燈光設計工作室，從劇場、舞蹈到建築與展覽現場，探索光在時間與空間中的敘事可能。</p></section>
  <div id="works"><WorkIndex /><section class="section"><p class="eyebrow">Selected Works</p><ProjectGrid projects={selected} /></section></div>
  <section class="upcoming section"><p class="eyebrow">Upcoming</p><div class="upcoming-list">{upcoming.map((project) => <a href={project.infoLink || sitePath(`/projects/${project.slug}`)} target={project.infoLink ? '_blank' : undefined} rel={project.infoLink ? 'noreferrer' : undefined}><span>{project.title}</span><span>{project.year}</span><b>→</b></a>)}</div></section>
  <section class="services section"><p class="eyebrow">Services</p><div><a href={sitePath('/services/theater-dance')}>劇場與舞蹈 <span>Theatre / Dance</span></a><a href={sitePath('/services/space-lighting')}>空間燈光 <span>Spatial Lighting</span></a><a href={sitePath('/services/exhibition')}>展覽 <span>Exhibition</span></a><a href={sitePath('/services/events')}>活動 <span>Events</span></a></div></section>
</BaseLayout>
<script>
  const slides = [...document.querySelectorAll<HTMLElement>('.slides picture')];
  if (slides.length > 1) setInterval(() => { const current = slides.findIndex((slide) => slide.classList.contains('visible')); slides[current].classList.remove('visible'); slides[(current + 1) % slides.length].classList.add('visible'); }, 4200);
</script>
<style>
  .landing{position:relative;min-height:calc(100svh - 58px);background:#131310;color:#f3f1ea;overflow:hidden}.slides,.slides picture,.slides img{position:absolute;inset:0;width:100%;height:100%}.slides picture{opacity:0;transition:opacity 1.2s ease}.slides picture.visible{opacity:.72}.slides img{object-fit:cover;object-position:var(--desktop-position)}.landing:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.48),transparent 65%)}.landing-copy{position:relative;z-index:1;display:flex;min-height:calc(100svh - 58px);padding:clamp(1.5rem,5vw,5rem) var(--edge);flex-direction:column;align-items:start;justify-content:space-between}.landing h1{margin:0;font-family:'IBM Plex Mono',monospace;font-size:clamp(4.5rem,14vw,13rem);line-height:.75;letter-spacing:-.1em}.landing-copy a{font-family:'IBM Plex Mono',monospace;font-size:12px}.landing-copy a span{margin-left:.7rem}.manifesto{display:grid;grid-template-columns:1fr 2fr;gap:2rem}.manifesto h2{margin:0;font-size:clamp(2rem,5vw,5rem);font-weight:500;line-height:1.25}.manifesto>p:last-child{grid-column:2;max-width:34rem}.upcoming-list{border-top:1px solid var(--line)}.upcoming-list a{display:grid;grid-template-columns:1fr auto auto;gap:1.5rem;padding:1rem 0;border-bottom:1px solid var(--line);align-items:center}.upcoming-list b{font-weight:400}.services{background:var(--ink);color:var(--paper)}.services>div{border-top:1px solid rgba(243,241,234,.35)}.services a{display:flex;justify-content:space-between;padding:1rem 0;border-bottom:1px solid rgba(243,241,234,.35);font-size:clamp(1.5rem,4vw,3.75rem)}.services span{font-family:'IBM Plex Mono',monospace;font-size:11px;padding-top:.8rem}@media(max-width:700px){.slides img{object-position:var(--mobile-position)}.manifesto{display:block}.manifesto h2{margin:2rem 0}.services a{font-size:1.4rem}.services span{font-size:9px}.landing h1{font-size:24vw}.upcoming-list a{grid-template-columns:1fr auto}.upcoming-list a span:nth-child(2){display:none}}
</style>
