---
import homepage from '../data/framer-home.html?raw';
import '../styles/framer-home.css';
import '../styles/home-interactions.css';
import { activeProjects } from '../data/projects';
import { sitePath } from '../lib/paths';
import { site } from '../config/site';
// Preserve the original DOM and five breakpoint styles; local scripts own interactions.
const markup = homepage
  .replace(/href="(?:\.\/|https:\/\/objetpetitlight\.framer\.website\/)([^"]*)"/g,
    (_, path) => `href="${sitePath(`/${path}`)}"`)
  .replace(/<form\b/, `<form action="${site.formEndpoint}" method="POST"`);
const rows = activeProjects.filter(p => ['Selected', 'Upcoming'].includes(p.selectedUpcoming))
  .sort((a, b) => a.homepageOrder - b.homepageOrder)
  .map(({ title, slug, cover, selectedUpcoming }) => ({ title, href: sitePath(`/projects/${slug}`), cover: cover.startsWith('/images/placeholder-') ? '' : cover, selected: selectedUpcoming === 'Selected' }));
const canonical = new URL(sitePath('/'), Astro.site);
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || 'JME5hkEBdaK-VIW6btaBN-jSAy5lRyrK6TeR1f9HAuc';
const schema = JSON.stringify({ '@context':'https://schema.org', '@type':'ProfessionalService', name:site.fullName, url:canonical.href, email:site.email, sameAs:[site.instagram, site.linkedin] });
---
<!doctype html>
<html lang="zh-Hant-TW" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>小幻光設計所 Objet Petit L(ighting)｜燈光設計工作室</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#F4F3EE" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content="小幻光設計所 Objet Petit L(ighting)｜燈光設計工作室" />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://framerusercontent.com/images/raWnl31aY07k9ncDMvgqXYD864.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    {verification && <meta name="google-site-verification" content={verification} />}
    <script type="application/ld+json" set:html={schema} />
    <link rel="icon" href="https://framerusercontent.com/images/Ore2V7jwc6PDMNYdVHoAivitqss.jpg" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chiron+Hei+HK:ital,wght@0,400;0,600&amp;display=swap" rel="stylesheet" />
  </head>
  <body data-home-rows={JSON.stringify(rows)} data-home-base={sitePath('/')}>
    <Fragment set:html={markup} />
    <script src="../scripts/home-interactions.ts"></script>
  </body>
</html>
