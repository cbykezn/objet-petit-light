---
import { sitePath } from '../lib/paths';
import { categories } from '../data/projects';
const links = [['服務','/services'], ['簡介 / CV','/profile-cv'], ['聯絡','/contact']];
---
<header class="header">
  <a class="brand" href={sitePath('/')} aria-label="Objet Petit L 首頁">Objet<br />Petit L</a>
  <button class="menu" aria-expanded="false" aria-controls="site-menu">MENU</button>
  <nav id="site-menu" aria-label="主要導覽">
    <div class="works-item">
      <button class="works-toggle" type="button" aria-expanded="false" aria-controls="works-menu" data-works-target={sitePath('/#works')}>
        作品 <span aria-hidden="true">+</span>
      </button>
      <div id="works-menu" class="works-menu" hidden>
        <p>WORK INDEX /</p>
        {categories.map((category) => <a href={sitePath(`/works/${category.slug}`)}>{category.label}<span>{category.english}</span></a>)}
      </div>
    </div>
    {links.map(([label, href]) => <a href={sitePath(href)}>{label}</a>)}
  </nav>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu');
  const nav = document.querySelector<HTMLElement>('#site-menu');
  const worksItem = document.querySelector<HTMLElement>('.works-item');
  const worksToggle = document.querySelector<HTMLButtonElement>('.works-toggle');
  const worksMenu = document.querySelector<HTMLElement>('#works-menu');

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('open', !open);
  });

  const closeWorksMenu = () => {
    worksMenu?.setAttribute('hidden', '');
    worksToggle?.setAttribute('aria-expanded', 'false');
    worksItem?.classList.remove('open');
  };

  worksToggle?.addEventListener('click', () => {
    const open = worksToggle.getAttribute('aria-expanded') === 'true';
    if (open) {
      window.location.assign(worksToggle.dataset.worksTarget || '/#works');
      return;
    }
    worksMenu?.removeAttribute('hidden');
    worksToggle.setAttribute('aria-expanded', 'true');
    worksItem?.classList.add('open');
  });

  document.addEventListener('pointerdown', (event) => {
    if (worksItem && !worksItem.contains(event.target as Node)) closeWorksMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeWorksMenu();
  });
</script>
<style>
  .header{position:relative;z-index:10;display:flex;align-items:start;justify-content:space-between;padding:1.1rem var(--edge);border-bottom:1px solid var(--line);font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.04em}
  .brand{font-size:16px;line-height:.9;font-weight:500;letter-spacing:-.07em}.menu{display:none;background:none;border:0;padding:0;color:inherit;font:inherit}nav{display:flex;gap:1.5rem;align-items:flex-start}nav a:hover,.works-toggle:hover{text-decoration:underline;text-underline-offset:.3em}
  .works-item{position:relative}.works-toggle{display:flex;gap:.35rem;align-items:center;padding:0;border:0;background:none;color:inherit;font:inherit;letter-spacing:inherit;cursor:pointer}.works-toggle span{display:inline-block;transition:transform .2s ease}.works-item.open .works-toggle span{transform:rotate(45deg)}
  .works-menu{position:absolute;top:calc(100% + .8rem);left:-.9rem;min-width:18rem;padding:.9rem;background:var(--paper);border:1px solid var(--line);box-shadow:0 .9rem 2rem rgba(17,17,15,.08)}.works-menu p{margin:0 0 .65rem;color:var(--muted);font-size:10px}.works-menu a{display:flex;justify-content:space-between;gap:1.5rem;padding:.55rem 0;border-top:1px solid var(--line);white-space:nowrap}.works-menu a span{color:var(--muted);font-size:10px}
  @media(max-width:700px){.menu{display:block}nav{display:none;position:absolute;top:100%;left:0;right:0;padding:1rem var(--edge) 1.4rem;background:var(--paper);border-bottom:1px solid var(--line);flex-direction:column;gap:.7rem}nav.open{display:flex}.works-menu{position:static;min-width:0;margin:.75rem 0 0;padding:.7rem .85rem;box-shadow:none}.works-menu a{white-space:normal}.works-menu a span{display:none}}
</style>
